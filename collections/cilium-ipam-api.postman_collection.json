          "name": "Cilium Allocate IP address",
          "request": {
            "name": "Cilium Allocate IP address",
            "description": {
              "content": "Allocates a new IP address from the configured IPAM pool for assignment to a new endpoint. Returns the allocated IP address and relevant routing information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ipam"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "family",
                  "value": "<string>",
                  "description": "IP address family to allocate (ipv4 or ipv6)."
                },
                {
                  "disabled": false,
                  "key": "owner",
                  "value": "<string>",
                  "description": "Owner identifier for the IP allocation."
                },
                {
                  "disabled": false,
                  "key": "expiration",
                  "value": "<boolean>",
                  "description": "Whether the allocation should expire if not confirmed."
